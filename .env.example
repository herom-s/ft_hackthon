# Cloud deploy
CLOUD_PROVIDER=aws                # or gcp, azure
DOMAIN=                           # Set to your domain for Let's Encrypt HTTPS
SSH_KEY_NAME=                     # AWS key pair name / GCP username
SSH_PUBLIC_KEY_PATH=              # Path to public key file (required for Azure, GCP; default: ~/.ssh/id_rsa.pub)

# Provider-specific
# GCP: set TF_VAR_project=<project-id> in .env
# AWS: credentials via env vars or ~/.aws/credentials; key pair must exist in region
# Azure: SSH_PUBLIC_KEY_PATH is required

# Name.com DNS (when using name.com for DNS management)
NAMECOM_USERNAME=                 # Name.com API username
NAMECOM_TOKEN=                    # Name.com API token

# API
API_PORT=8000
TRAEFIK_HTTPS_PORT=8443

# PostgreSQL
POSTGRES_USER=ft_hackthon
POSTGRES_PASSWORD=ft_hackthon
POSTGRES_DB=ft_hackthon

# Gitea
GITEA_PORT=3222
GITEA_ADMIN_USER=ft_hackthon
GITEA_ADMIN_PASSWORD=changeme123
GITEA_ORG=ft_hackthon
GITEA_PUBLIC_URL=http://localhost:3222

# Grading
WORKER_ID=worker-1
# Suites without a Dockerfile are refused by default. Set to true ONLY for
# local development: it runs untrusted student code directly on the host.
# GRADER_ALLOW_UNSANDBOXED=true

# Backup
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7
